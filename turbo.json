{
  "$schema": "https://v2-11-10.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "cache": true,
      "inputs": ["src/**/*", "eslint.config.mjs", "tsconfig.json", "package.json"]
    },
    "format": {
      "cache": false,
      "inputs": ["src/**/*", ".prettierrc", ".prettierignore", "package.json"]
    },
    "format:check": {
      "cache": true,
      "inputs": ["src/**/*", ".prettierrc", ".prettierignore", "package.json"]
    },
    "tsc:check": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["src/**/*", "tsconfig.json"]
    }
  }
}
