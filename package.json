{
  "name": "foundry2d",
  "private": true,
  "scripts": {
    "dev:pixel": "pnpm --dir apps/pixel-editor dev",
    "dev:level": "pnpm --dir apps/level-designer dev",
    "test": "turbo run test",
    "test:store": "turbo run test --filter=@foundry2d/store",
    "turbo:telemetry:enable": "turbo telemetry enable",
    "turbo:telemetry:disable": "turbo telemetry disable",
    "tsc:check": "turbo run tsc:check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.72.0"
  },
  "packageManager": "pnpm@12.14.0"
}
