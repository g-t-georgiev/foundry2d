{
  "name": "gs2d",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001",
      "vite-plus": "1.8.0"
    }
  },
  "scripts": {
    "dev": "vp run --parallel --filter \"./apps/*\" dev",
    "build:site": "vpx scripts/build-site.ts",
    "preview:site": "vp run --filter ./apps/studio preview:site",
    "dev:pixel": "vp run --filter ./apps/pixel dev",
    "dev:levels": "vp run --filter ./apps/levels dev",
    "dev:packer": "vp run --filter ./apps/packer dev",
    "dev:docs": "vp run --filter ./apps/docs dev",
    "test": "vp run -r test",
    "tsc:check": "vp run -r tsc:check",
    "lint": "vp lint .",
    "lint:fix": "vp lint . --fix",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "prepare": "vp config",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "docs": "vpx scripts/docs.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.5",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "^5.4.0",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001"
  },
  "trustedDependencies": [
    "esbuild"
  ],
  "packageManager": "bun@1.4.5"
}
