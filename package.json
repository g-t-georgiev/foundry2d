{
  "name": "foundry2d",
  "private": true,
  "scripts": {
    "dev:pixel": "pnpm --dir apps/pixel-editor dev",
    "dev:level": "pnpm --dir apps/level-designer dev",
    "test": "turbo run test",
    "test:store": "turbo run test --filter=@foundry2d/store",
    "turbo:telemetry:enable": "turbo telemetry enable",
    "turbo:telemetry:disable": "turbo telemetry disable",
    "tsc:check": "turbo run tsc:check",
    "lint": "vp lint .",
    "lint:fix": "vp lint . --fix",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "prepare": "vp config"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "^5.4.0",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.14.0"
}
