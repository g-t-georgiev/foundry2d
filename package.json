{
  "name": "gs2d",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "build:site": "vpx scripts/build-site.ts",
    "preview:site": "pnpm --dir apps/studio exec vp preview --outDir ../../build/site --port 4180 --strictPort",
    "dev:pixel": "pnpm --dir apps/pixel dev",
    "dev:levels": "pnpm --dir apps/levels dev",
    "dev:packer": "pnpm --dir apps/packer dev",
    "dev:docs": "pnpm --dir apps/docs dev",
    "test": "turbo run test",
    "test:store": "turbo run test --filter=@gs2d/store",
    "turbo:telemetry:enable": "turbo telemetry enable",
    "turbo:telemetry:disable": "turbo telemetry disable",
    "tsc:check": "turbo run tsc:check",
    "lint": "vp lint .",
    "lint:fix": "vp lint . --fix",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "prepare": "vp config",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "docs": "vpx scripts/docs.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.5",
    "turbo": "^2.11.10",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "^5.4.0",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.14.0"
}
